{
  "name": "jev-harness",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Harness for TypeSafe's Jev decision model: typed questions over datasets via OpenRouter, JSONL answers, summary reports.",
  "keywords": [
    "jev",
    "typesafe-ai",
    "system-one",
    "openrouter",
    "decision-model",
    "classification",
    "routing",
    "harness",
    "bun",
    "typescript"
  ],
  "author": "Casey Hand <casey@caseyjhand.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/jev-harness.git"
  },
  "bugs": "https://github.com/cyanheads/jev-harness/issues",
  "homepage": "https://github.com/cyanheads/jev-harness#readme",
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis/index.ts",
    "./client": "./src/client/index.ts",
    "./questions": "./src/questions/index.ts",
    "./experiments": "./src/experiments/index.ts",
    "./input": "./src/input/index.ts",
    "./run": "./src/run/index.ts"
  },
  "scripts": {
    "jev": "bun run bin/jev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run changelog:check",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
