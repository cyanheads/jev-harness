# Which API serves Jev. `openrouter` (default) needs OPENROUTER_API_KEY;
# `typesafe` calls api.typesafe.ai directly and needs TYPESAFE_API_KEY.
JEV_PROVIDER=openrouter

# OpenRouter key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# TypeSafe key — https://console.typesafe.ai/settings/keys (early access)
# TYPESAFE_API_KEY=sk-...

# Pin the model. Defaults: `typesafe/jev-1.13` on OpenRouter, `jev-1.13.0` on TypeSafe.
# Aliases (`jev-latest`) move when a new release ships and can change answers under you.
# JEV_MODEL=typesafe/jev-1.13
